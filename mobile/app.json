{
  "expo": {
    "name": "Astralis",
    "description": "Astronomy-accurate astrology mapped to your real sky, with birthplace-aware charts and a calm design inspired by Mongolia's vast night sky.",
    "slug": "astralis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a1a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.astralis.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0a1a"
      },
      "package": "com.astralis.mobile",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "scheme": "astralis",
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#8b6bff",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "https://horoscope-frontend.pages.dev/privacy",
      "termsOfServiceUrl": "https://horoscope-frontend.pages.dev/terms",
      "accountDeletionUrl": "https://horoscope-frontend.pages.dev/delete-account",
      "eas": {
        "projectId": "7dc13d4a-186c-4622-8a71-d7311cb13d22"
      }
    },
    "owner": "ankhbayar-0430"
  }
}
