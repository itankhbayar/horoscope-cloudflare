# Copied to `.env` in this folder (Expo loads EXPO_PUBLIC_* at bundle time).
#
# Physical phone / tablet: 127.0.0.1 is the DEVICE itself — use your PC's LAN IP
# (same Wi‑Fi), e.g. http://192.168.1.42:8787  (run `ipconfig` on Windows, ifconfig on Mac)
# Backend must listen on all interfaces: from `backend` run `npm run dev` (uses --ip 0.0.0.0).
#
# iOS Simulator on the same Mac as Wrangler: http://127.0.0.1:8787 is OK.
# Android emulator → host machine: often http://10.0.2.2:8787
#
# Deployed Worker:
# EXPO_PUBLIC_API_BASE_URL=https://your-worker.workers.dev

EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:8787

# Stripe test publishable key (pk_test_...) for @stripe/stripe-react-native PaymentSheet (Android).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=test_YInlheaRAVArZKEwCqXYtCEKeTU

# RevenueCat (iOS Apple IAP — optional until Apple Developer setup is complete)
# Leave unset to show "Purchases are not configured yet" on iOS instead of enabling IAP.
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_xxx
# Optional: offering / package identifiers from the RevenueCat dashboard
# EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
# EXPO_PUBLIC_REVENUECAT_PACKAGE_MONTHLY=monthly
# EXPO_PUBLIC_REVENUECAT_PACKAGE_ANNUAL=annual
