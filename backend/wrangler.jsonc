{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-29",
	"dev": {
		"port": 8787,
		// Listen on all interfaces so phones on the same Wi‑Fi can reach local dev (not only 127.0.0.1).
		"ip": "0.0.0.0"
	},
	"triggers": {
		// 16:01 UTC ≈ 00:01 Asia/Ulaanbaatar — horoscope + tarot prewarm for CRON_TIMEZONE calendar day.
		// 0 * * * * — hourly retention pass: timezone-aware push enqueue + delivery + receipts.
		"crons": ["1 16 * * *", "0 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "horoscope_db",
			"database_name": "horoscope-db",
			"database_id": "a0268569-dbcc-4736-95bc-b9a9092b20e5",
			"migrations_dir": "drizzle"
		}
	],
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMITER",
			"namespace_id": "240101",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "REGISTER_RATE_LIMITER",
			"namespace_id": "240102",
			"simple": { "limit": 3, "period": 60 }
		},
		{
			"name": "REFRESH_RATE_LIMITER",
			"namespace_id": "240103",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			"name": "PUBLIC_RATE_LIMITER",
			"namespace_id": "240104",
			"simple": { "limit": 120, "period": 60 }
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "RATE_LIMITER_DO",
				"class_name": "RateLimitBucket"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1_rate_limit_bucket",
			"new_sqlite_classes": ["RateLimitBucket"]
		}
	],
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "horoscope"
		}
	],
	"compatibility_flags": ["nodejs_compat_v2"],
	"vars": {
	  "APP_PUBLIC_URL": "https://horoscope-frontend.pages.dev",
	  "CRON_TIMEZONE": "Asia/Ulaanbaatar",
	},
	// In production, replace ADMIN_SECRET with a real secret via:
	//   npx wrangler secret put ADMIN_SECRET
	// then remove it from `vars` above.
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "d1_databases": [
	//   {
	//     "binding": "MY_DB",
	//     "database_name": "my-database",
	//     "database_id": ""
	//   }
	// ],
	// "ai": {
	//   "binding": "AI"
	// },
	// "observability": {
	//   "enabled": true,
	//   "head_sampling_rate": 1
	// }
}
