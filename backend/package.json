{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "allow-firewall": "powershell -ExecutionPolicy Bypass -File ./scripts/allow-wrangler-dev-firewall.ps1",
    "stripe:listen": "stripe listen --forward-to http://127.0.0.1:8787/api/billing/webhook",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "validate:cron": "node scripts/validate-cron-schedule.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.15",
    "stripe": "^17.7.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.4.0"
  }
}
