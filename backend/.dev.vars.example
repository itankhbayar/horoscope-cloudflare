# Public web app URL (Stripe checkout success/cancel redirects).
# Required for auth JWT signing in local dev.
JWT_SECRET=local-dev-jwt-secret-change-me

APP_PUBLIC_URL=http://localhost:5173

# Stripe test keys (do not commit real values).
#
# Webhook signing secret MUST match how you receive events:
# - stripe listen --forward-to http://127.0.0.1:8787/api/billing/webhook
#   → use the whsec_... printed in THAT terminal (changes when you restart listen).
# - Stripe Dashboard “endpoint” signing secret → only if Stripe servers POST directly (not CLI).
# Paste with no extra spaces/newlines, or signature verification returns 400.
#
# `npm run dev` loads ../.dev.vars (repo root) via --env-file. You can instead
# copy this file to backend/.dev.vars and remove --env-file from package.json.

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
# Optional: extra test Price ID allowed for POST /api/billing/mobile/checkout (server allowlist).
# If unset, mobile defaults to STRIPE_PRICE_ID.
STRIPE_PREMIUM_PRICE_ID_TEST=price_xxx_test_only

# RevenueCat (optional until Apple IAP is live — routes return 503 when unset)
# REVENUECAT_API_KEY=
# REVENUECAT_WEBHOOK_SECRET=

# Expo push delivery (optional). Required only if you enable "Enhanced Security for
# Push Notifications" in the Expo dashboard; otherwise Expo accepts unauthenticated sends.
# EXPO_ACCESS_TOKEN=

# Optional password breach checks for new registrations.
# Disabled by default. When enabled, the Worker uses the HaveIBeenPwned k-anonymity range API:
# only the first 5 SHA-1 hash characters are sent, and suffixes are compared locally.
PWNED_PASSWORD_CHECK_ENABLED=false
# Keep false unless you intentionally want registration to fail when HIBP is unavailable.
PWNED_PASSWORD_FAIL_CLOSED=false

# Optional production observability. Leave SENTRY_DSN unset in local dev.
APP_ENV=development
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# Webhook local testing (requires Stripe CLI + wrangler dev on 8787):
#   npm run stripe:listen
# Copy the printed "whsec_..." into STRIPE_WEBHOOK_SECRET and restart wrangler dev.
#
# Stripe Dashboard → Webhooks → add events used by this Worker:
#   checkout.session.completed, payment_intent.succeeded, invoice.paid,
#   invoice.payment_failed, customer.subscription.updated, customer.subscription.deleted
