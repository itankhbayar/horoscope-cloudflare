# Stripe test keys (do not commit real values).
#
# `npm run dev` loads ../.dev.vars (repo root) via --env-file. You can instead
# copy this file to backend/.dev.vars and remove --env-file from package.json.

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# Webhook local testing (requires Stripe CLI + wrangler dev on 8787):
#   npm run stripe:listen
# Copy the printed "whsec_..." into STRIPE_WEBHOOK_SECRET and restart wrangler dev.
