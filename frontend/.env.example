# Local dev: leave empty to proxy /api → http://127.0.0.1:8787 (see vite.config.ts)
# Production / Pages: set to your deployed Worker URL
VITE_API_BASE_URL=https://backend.ankhbayr2017.workers.dev

# Optional analytics / error tracking. Leave unset in local dev.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_APP_ENV=development
VITE_APP_RELEASE=
